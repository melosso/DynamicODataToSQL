<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Build">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Melosso.DynamicODataToSQL</PackageId>
    <Product>DynamicODataToSQL</Product>
    <Description>Convert OData query strings into parameterized SQL using SqlKata. Melosso fork adding $expand navigation-property support.</Description>
    <PackageTags>odata;sql;dynamic;expand;sqlkata;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OData.Core" Version="9.0.0" />
    <PackageReference Include="SqlKata" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
   <None Include="..\..\Images\Icon.png" Pack="true" PackagePath=""/>
  </ItemGroup>

</Project>
